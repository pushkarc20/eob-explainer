# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=
# Model ID and effort live here so they are changed in one place
EOB_CLOUD_MODEL=claude-sonnet-5-5
EOB_CLOUD_EFFORT=medium
# Local mode (Ollama). Leave EOB_LOCAL_THINK blank for the model's default; use false for qwen3 models.
EOB_LOCAL_MODEL=
EOB_LOCAL_URL=http://localhost:11434
EOB_LOCAL_THINK=
